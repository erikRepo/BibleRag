# Copy this file to .env and adjust as needed.

# Base URL of your local Ollama instance
OLLAMA_HOST=http://localhost:11434

# Embedding model pulled via `ollama pull`
EMBED_MODEL=nomic-embed-text

# Chat/generation model pulled via `ollama pull`
CHAT_MODEL=qwen3.5:9b

# Path to the Bible XML file (Holy-Bible-XML-Format layout: testament/book/chapter/verse)
BIBLE_XML=./data/EnglishKJBible.xml

# Where the Chroma persistent vector store is written
CHROMA_DIR=./data/chroma

# How many verses per chunk (sliding window) when indexing
CHUNK_SIZE=4
CHUNK_OVERLAP=1
