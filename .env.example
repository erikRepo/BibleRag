# Copy this file to .env and adjust as needed.

# Base URL of your local Ollama instance
OLLAMA_HOST=http://localhost:11434

# Embedding model pulled via `ollama pull`
EMBED_MODEL=nomic-embed-text

# Chat/generation model pulled via `ollama pull`
CHAT_MODEL=qwen3.5:9b

# Path to the Bible XML file used for search/embedding (always English -
# see README for why). Holy-Bible-XML-Format layout: testament/book/chapter/verse
BIBLE_XML=./data/EnglishKJBible.xml

# Path to a local clone of https://github.com/ - "Holy-Bible-XML-Format",
# which ships dozens of translations/languages in the same XML layout.
# Used to look up verse text in another language for --lang (see
# languages.toml for the code -> filename mapping). Not required if you
# only ever query in English.
BIBLE_REPO_PATH=~/git/Holy-Bible-XML-Format

# Where the Chroma persistent vector store is written
CHROMA_DIR=./data/chroma

# How many verses per chunk (sliding window) when indexing
CHUNK_SIZE=4
CHUNK_OVERLAP=1
